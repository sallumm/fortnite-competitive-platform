{
  "name": "clutchfolio",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "node scripts/frontend-env-check.mjs && tsc -b && tsc -p tsconfig.coach.json && vite build && node scripts/sitemap.mjs && node scripts/prerender-editorial.mjs",
    "build:staging": "node scripts/staging-build.mjs",
    "check:staging": "node scripts/staging-check.mjs",
    "check:staging-artifact": "node scripts/staging-artifact.mjs --check",
    "preview": "vite preview --host 0.0.0.0",
    "test": "vitest run",
    "format": "prettier --write src tests scripts *.json *.ts *.html",
    "test:e2e": "playwright test",
    "check:production": "node scripts/production-check.mjs",
    "report:bundle": "node scripts/bundle-report.mjs",
    "check:brand": "node scripts/brand-check.mjs",
    "check:security": "node scripts/security-check.mjs",
    "lint": "tsc -b && tsc -p tsconfig.coach.json && node scripts/security-check.mjs"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@supabase/supabase-js": "^2.0.0",
    "lucide-react": "^0.577.0",
    "motion": "^14.1.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-router-dom": "^7.0.0",
    "recharts": "^3.0.0",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@electric-sql/pglite": "^0.3.0",
    "@playwright/test": "^1.64.0",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^5.0.0",
    "jsdom": "^30.1.2",
    "prettier": "^3.9.9",
    "typescript": "^5.9.0",
    "vite": "^7.0.0",
    "vitest": "^5.0.3"
  }
}
